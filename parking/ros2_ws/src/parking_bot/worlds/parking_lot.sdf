<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="parking_lot">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo Fortress (ignition-gazebo6) 플러그인 파일명/네임스페이스 -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <!-- 센서(gpu_lidar/camera) 렌더링 ogre2 유지. legacy ogre1로 바꿔봤더니
           gpu_lidar가 로봇 자체 몸체를 오탐지해 스폰 직후부터 emergency-avoidance가
           계속 발동하는 문제가 생겼다(SEARCH가 아예 실행 안 되고 장애물에 충돌).
           ogre2는 GPU(D3D12) 가속 하에서는 GenerateHwMipmaps에서 100% 크래시하지만,
           완전 소프트웨어 렌더링(launch/sim.launch.py의 LIBGL_ALWAYS_SOFTWARE=1)에서는
           안정적으로 동작한다 - 이전 세션 로그로 여러 번 확인됨. -->
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

    <!-- 기본 카메라: 3D 원근 유지하면서, 참고 이미지처럼 보도블록(닫힌 쪽)이
         화면 위쪽에 오도록 진입로 뒤쪽 위에서 비스듬히 내려다보는 각도로 배치 -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -4.6 3.4 1.5708 0.55 1.5708</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <!-- WSLg 소프트웨어 렌더링(llvmpipe/kms_swrast)에서 그림자 렌더링 비용이 커서
           GUI가 CPU를 계속 90%+ 씩 쓰며 사실상 응답이 멈춘 것처럼 보이는 문제가 있어
           꺼둔다 - 시각적으로만 손해, 시뮬레이션/제어 로직과는 무관. -->
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- ============================================================
         후진 주차장 치수 (후진주차장.png 픽셀 좌표를 직접 측정해 재검증한 값입니다.
         이전 버전은 안쪽 장애물의 가로/세로를 서로 바꿔서 넣었고, 그 장애물을 대상
         슬롯 "안쪽 끝"으로 오인해 배치하는 두 가지 오류가 있었습니다 - 아래 참고.)

         - 주차 슬롯(대상 구역, 로봇이 들어갈 빈 공간) : 폭 1000mm x 깊이 1600mm,
           전 구간이 비어 있음(장애물 없음).
         - 차선 폭 : 100mm
         - 이미 주차된 차량(장애물) 규격 : 이삿짐 박스 12호 900 x 500 x 600 mm.
           단, 세 장애물이 이 900x500 박스를 서로 다른 방향으로 눕혀 놓은 것이라
           박스마다 실제 가로/세로 배치가 다릅니다 (아래 개별 주석 참고).

         좌표계 : 슬롯 입구가 y=0, 안쪽(슬롯 경계/정지선)이 y=1.6. 슬롯 폭 중심 x=0.

         치수 재해석 (도면 픽셀을 직접 측정) :
         - 좌/우 포스트(라인 쌍) 중심선 간격이 1000mm이고, 라인 폭 100mm를 빼면 실제
           통행 가능 폭은 1000-100=900mm. 이건 기존 해석과 동일합니다.
         - "1600mm" 화살표는 입구부터 슬롯 안쪽의 정지선(가운데 두 포스트 사이를 가로
           지르는 이중 가로줄, 폭 100mm)까지만 잽니다. 안쪽(보도블록 바로 아래) 빨간
           박스는 이 정지선보다 더 위, 즉 대상 슬롯 밖(정지선~보도블록 사이)에 있습니다.
           => 대상 슬롯 1600mm 전 구간이 로봇이 실제로 후진해 들어갈 수 있는 빈 공간이고,
              이래야 "슬롯이 차량 규격(1.4m)보다 소폭(200mm)만 크다"는 전제와 맞습니다.
              (이전 버전처럼 안쪽 장애물이 슬롯 안쪽 900mm를 차지한다고 보면 로봇 길이
              1.4m가 들어갈 자리가 700mm밖에 안 남아 물리적으로 불가능했습니다.)
         - 정지선~보도블록 사이 여유가 "200mm"이고, 그 다음에 안쪽 장애물(900x500)이
           보도블록에 바짝 붙어 있습니다. 이 박스는 가로(900mm)가 슬롯 폭 방향, 세로
           (500mm)가 깊이 방향입니다(왼쪽/오른쪽 박스와는 가로세로가 반대).
         - 좌/우 옆 칸 장애물은 입구(y=0)에서 100mm 띄워 배치(도면 우측 박스 아래
           "100mm" 화살표) -> y=[0.1, 1.0]. 이 박스는 폭 500mm(x) x 깊이 900mm(y)로
           기존 해석 그대로입니다.
         ============================================================ -->

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>14 12</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>14 12</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 슬롯 안쪽 경계(정지선) : 도면의 이중 가로줄, 폭 100mm. 대상 슬롯(1600mm)은
         여기까지이고, 물리적 충돌체는 없음(시각 표시 전용 - 로봇이 이 선을 살짝
         넘어도 안전하게 멈추도록 정지 목표는 이 선보다 안쪽에 두지 않는다). -->
    <model name="slot_back_boundary">
      <static>true</static>
      <pose>0 1.65 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.0 0.1 0.002</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 보도블록 (정지선에서 200mm 여유 + 안쪽 장애물 500mm 뒤, 오렌지색) -->
    <model name="curb">
      <static>true</static>
      <pose>0 2.375 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.15 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.15 0.15</size></box></geometry>
          <material>
            <ambient>0.85 0.45 0.1 1</ambient>
            <diffuse>0.85 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 주차 슬롯 좌측 차선 (흰색, 시각 표시 전용 / 충돌체 없음, 폭 100mm) -->
    <model name="line_left">
      <static>true</static>
      <pose>-0.5 0.8 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.1 1.6 0.002</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 주차 슬롯 우측 차선 (폭 100mm) -->
    <model name="line_right">
      <static>true</static>
      <pose>0.5 0.8 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.1 1.6 0.002</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 장애물 1: 대상 슬롯 밖(정지선~보도블록 사이), 보도블록에 붙여 고정된 물체.
         가로(폭) 900mm x 세로(깊이) 500mm - 좌/우 장애물과 가로세로가 반대다.
         정지선(y=1.6)에서 200mm 띄우고(y=1.8) 깊이 500mm를 차지 -> y=[1.8, 2.3],
         보도블록(안쪽 면 y=2.3)에 바짝 붙는다. 대상 슬롯(y<=1.6) 안으로는 침범하지
         않으므로 로봇의 정상 주차 동작과는 무관하고, 후방 충돌 방지용 최후 여유일 뿐. -->
    <model name="parked_box_inner">
      <static>true</static>
      <pose>0 2.05 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.9 0.5 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 장애물 2: 슬롯 좌측 옆 칸 이미 주차된 차량
         y=0.55 (span [0.1, 1.0]) : 후진주차장.png 우측 박스 아래 "100mm" 화살표대로
         입구(y=0)에서 100mm 띄워 배치(박스 깊이 900mm). 이전엔 도면을 안 보고
         임의로 150mm 띄워서(y=0.6) 규격과 안 맞았음. -->
    <model name="parked_box_left">
      <static>true</static>
      <pose>-0.85 0.55 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.9 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.9 0.6</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 장애물 3: 슬롯 우측 옆 칸 이미 주차된 차량
         y=0.55 (span [0.1, 1.0]) : 좌측과 동일하게 입구에서 100mm 띄움(도면 우측
         박스 아래 "100mm" 화살표 그대로 반영) -->
    <model name="parked_box_right">
      <static>true</static>
      <pose>0.85 0.55 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.9 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.9 0.6</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
